# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 聪明钱配置（可选）=====
# 启用聪明钱链上数据拉取（默认 true）
# SMART_MONEY_ENABLED=true
# 聪明钱 API 请求超时秒数（默认 15）
# SMART_MONEY_TIMEOUT=15
# Polygon RPC endpoint（备用方案，目前未使用）
# SMART_MONEY_RPC_URL=

# ===== Redis 配置（可选）=====
# 用于持久化预测历史，不配置则使用默认值，无 Redis 时自动降级为纯内存模式
# REDIS_URL=redis://localhost:6379/0
# PREDICTION_TTL=604800

# ===== 数据库配置 =====
DATABASE_URL=postgresql://mirofish:mirofish@localhost:5432/mirofish

# ===== JWT 配置 =====
JWT_SECRET_KEY=your-jwt-secret-key

# ===== SMTP 邮件配置（可选，不配置则验证码打印到日志）=====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# ===== Polygon 充值配置 =====
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
PLATFORM_WALLET_ADDRESS=
DEPOSIT_MIN_CONFIRMATIONS=5